{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": true,
  "disableClaudeAiConnectors": true,
  "deniedMcpServers": [
    {
      "serverName": "agentic-controller"
    }
  ],
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(jq *)",
      "Bash(bash -n *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(python3 *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(rtk git *)",
      "Bash(rtk ls *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk rg *)",
      "Bash(rtk cat *)",
      "Bash(rtk head *)",
      "Bash(rtk tail *)",
      "Bash(rtk wc *)",
      "Bash(rtk diff *)",
      "Bash(rtk tree *)",
      "Bash(rtk which *)",
      "Bash(rtk jq *)",
      "Bash(rtk bash -n *)",
      "Bash(rtk node *)",
      "Bash(rtk pnpm *)",
      "Bash(rtk yarn *)",
      "Bash(rtk npm *)",
      "Bash(rtk npx *)",
      "Bash(rtk bun *)",
      "Bash(rtk python3 *)",
      "Bash(rtk go *)",
      "Bash(rtk cargo *)",
      "Bash(rtk docker ps *)",
      "Bash(rtk docker logs *)",
      "Bash(rtk docker compose ps *)",
      "Bash(rtk docker compose logs *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh run view *)",
      "Bash(rtk gh run list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(rtk git push *)",
      "Bash(rtk git reset --hard*)",
      "Bash(rtk git clean *)",
      "Bash(rtk git branch -D *)",
      "Bash(rtk git checkout -- *)",
      "Bash(rtk git restore *)",
      "Bash(rtk find * -delete*)",
      "Bash(rtk find * -exec *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-start-handoff.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pre-bash-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/rtk-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/post-edit-format.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*pnpm install*)",
            "async": true,
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'pnpm install done'"
          },
          {
            "type": "command",
            "if": "Bash(*yarn install*)",
            "async": true,
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'yarn install done'"
          },
          {
            "type": "command",
            "if": "Bash(npm install*)",
            "async": true,
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'npm install done'"
          },
          {
            "type": "command",
            "if": "Bash(rtk npm install*)",
            "async": true,
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'npm install done'"
          },
          {
            "type": "command",
            "if": "Bash(*bun install*)",
            "async": true,
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'bun install done'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'Claude is waiting for you'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'Response finished'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
