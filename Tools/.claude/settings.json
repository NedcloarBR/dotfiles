{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(jq *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(npm *)",
      "Bash(bun *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(rtk git *)",
      "Bash(rtk ls *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk rg *)",
      "Bash(rtk cat *)",
      "Bash(rtk head *)",
      "Bash(rtk tail *)",
      "Bash(rtk wc *)",
      "Bash(rtk diff *)",
      "Bash(rtk tree *)",
      "Bash(rtk which *)",
      "Bash(rtk jq *)",
      "Bash(rtk pnpm *)",
      "Bash(rtk yarn *)",
      "Bash(rtk npm *)",
      "Bash(rtk bun *)",
      "Bash(rtk go *)",
      "Bash(rtk cargo *)",
      "Bash(rtk docker ps *)",
      "Bash(rtk docker logs *)",
      "Bash(rtk docker compose ps *)",
      "Bash(rtk docker compose logs *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh run view *)",
      "Bash(rtk gh run list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(rtk git push *)",
      "Bash(rtk git reset --hard*)",
      "Bash(rtk git clean *)",
      "Bash(rtk git branch -D *)",
      "Bash(rtk git checkout -- *)",
      "Bash(rtk git restore *)",
      "Bash(rtk find * -delete*)",
      "Bash(rtk find * -exec *)"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "deniedMcpServers": [
    {
      "serverName": "agentic-controller"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-start-handoff.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pre-bash-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/rtk-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/post-edit-format.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'pnpm install done'",
            "if": "Bash(*pnpm install*)",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'yarn install done'",
            "if": "Bash(*yarn install*)",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'npm install done'",
            "if": "Bash(npm install*)",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'npm install done'",
            "if": "Bash(rtk npm install*)",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'bun install done'",
            "if": "Bash(*bun install*)",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'Claude is waiting for you'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\" 'Response finished'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: varies per repo; public repos never receive confidential material or secrets",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: per repo; treat the repo's default branch (main/master/Master) as protected",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: the current working directory's git repository and its own remote only — as scoped by Trusted repo and Repository visibility",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (TypeScript/NestJS projects, personal tooling)",
      "**Trusted repo**: the current working directory's git repository and its own remote. Confidential material is never cleared into public repos, and secrets/sensitive data are never cleared in regardless of visibility",
      "**Org-specific CLIs**: None configured",
      "**Routine under NedcloarBR/ prefix**: repos under github.com/NedcloarBR/* are the user's own work; routine git/editor/package-manager operations there are expected"
    ]
  }
}
